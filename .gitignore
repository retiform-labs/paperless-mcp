# Dependencies
node_modules/
node_modules
bun.lock

# Environment variables
.env
.env.local
.env.*.local

# Build output
dist/
build/
coverage/
package/
*.dxt

# Logs
logs/
*.log
# ...except preserved measurement output. eval/results/ holds the raw run behind a
# published number; a baseline that is not committed is a baseline nobody can check.
!eval/results/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Devfiles / Temp stuff
temp/

# Serena (MCP code-intelligence tool) local project state.
# Regenerated automatically by `activate_project` on each machine, so it is
# per-machine configuration rather than project source.
.serena/

# ---- private eval fixtures -------------------------------------------------
# These name our own corpus: restricted-practice terms and document titles from
# a private library. The SCHEMA is public (see eval/queries.example.json); the
# CASES are not. `run.mjs` and `bakeoff.mjs` read eval/queries.json, so an
# operator supplies their own copy from the example.
eval/queries.json
eval/live.mjs
live3.mjs
