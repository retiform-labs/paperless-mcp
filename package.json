{
  "name": "@retiform/paperless-mcp",
  "version": "2.4.1",
  "description": "MCP server for Paperless-NGX with bounded content reads - ranged document windows and passage search so agents never flood their context.",
  "main": "build/index.js",
  "bin": {
    "paperless-mcp": "build/index.js"
  },
  "scripts": {
    "test": "node --require ts-node/register --test \"src/**/*.test.ts\"",
    "test:e2e": "node --require ts-node/register --test e2e/e2e.test.ts",
    "start": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "opsec-preflight": "bash scripts/opsec-preflight.sh",
    "dxt-pack": "dxt pack",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector node build/index.js",
    "prepack": "rm -rf build && npm run build && npm run sync-manifest && npm run dxt-pack",
    "sync-manifest": "node scripts/sync-manifest-version.mjs && node scripts/sync-manifest-tools.mjs",
    "eval": "node eval/run.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync-manifest-tools": "node scripts/sync-manifest-tools.mjs",
    "prepublishOnly": "npm run build",
    "release:gate": "npm run build && npm run opsec-preflight"
  },
  "keywords": [
    "mcp",
    "paperless-ngx",
    "document-management",
    "ai",
    "claude",
    "model-context-protocol",
    "paperless"
  ],
  "author": "Guan <guan@retiform.dev>",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retiform-labs/paperless-mcp.git"
  },
  "homepage": "https://github.com/retiform-labs/paperless-mcp",
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "paperless-mcp.dxt"
  ],
  "bugs": {
    "url": "https://github.com/retiform-labs/paperless-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.2.0",
    "express": "^5.1.0",
    "form-data": "^4.0.2",
    "sqlite-vec": "^0.1.9",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/dxt": "^0.2.6",
    "@changesets/cli": "^2.29.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.2",
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
